# ── Core ─────────────────────────────────────────────────────────────────────
ENV=development                        # development | production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sql_practice
REDIS_URL=redis://localhost:6379/0

# ── URLs ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
VITE_BACKEND_URL=                      # leave blank in single-service deploy
SECURE_COOKIES=false                   # set true in production

# ── Razorpay (INR) ───────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_PRO=plan_...             # monthly Pro subscription plan id
RAZORPAY_PLAN_ELITE=plan_...           # monthly Elite subscription plan id
RAZORPAY_AMOUNT_LIFETIME_PRO=1199900   # paise (₹11,999)
RAZORPAY_AMOUNT_LIFETIME_ELITE=1999900 # paise (₹19,999)
RAZORPAY_CURRENCY=INR

# ── Razorpay (USD) ───────────────────────────────────────────────────────────
RAZORPAY_PLAN_PRO_USD=                 # optional: USD monthly Pro plan id
RAZORPAY_PLAN_ELITE_USD=               # optional: USD monthly Elite plan id
RAZORPAY_AMOUNT_LIFETIME_PRO_USD=12900   # cents ($129)
RAZORPAY_AMOUNT_LIFETIME_ELITE_USD=22900 # cents ($229)

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=datathink <noreply@datathink.co>

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# production: GOOGLE_REDIRECT_URI=https://datathink.co/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback
# production: GITHUB_REDIRECT_URI=https://datathink.co/api/auth/oauth/github/callback

# ── Auth tuning ───────────────────────────────────────────────────────────────
LOGIN_LOCKOUT_MAX_ATTEMPTS=5           # failed attempts before account lock
LOGIN_LOCKOUT_WINDOW_MINUTES=15
MAGIC_LINK_TTL_MINUTES=10
OAUTH_STATE_TTL_MINUTES=5

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_TOKEN_ISSUE_RATE_LIMIT_REQUESTS=5
AUTH_TOKEN_ISSUE_RATE_LIMIT_WINDOW_SECONDS=300

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                            # backend error capture
SENTRY_RELEASE=                        # optional: git sha or version tag
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=                       # frontend error capture + session replay
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
